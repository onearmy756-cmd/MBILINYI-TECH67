# ================================================================
#  Mbilinyi Tech Solutions — environment template
#
#  Copy this file to .env and fill in what you have.
#  Every value is OPTIONAL: with an empty .env the site still runs
#  (it falls back to a SQLite file in storage/mts.sqlite).
# ================================================================

# ---- Database -------------------------------------------------
# Leave BLANK to let the app choose automatically:
#   1. a local MariaDB/MySQL if one is reachable,
#   2. otherwise SQLite in storage/mts.sqlite (no setup needed).
#
# On cPanel, create the database + user in "MySQL Databases" and put
# the values here. Both forms work:
#   DATABASE_URL=mysql://cpuser_dbuser:password@localhost:3306/cpuser_mbilinyi
#   DATABASE_URL=localhost|cpuser_mbilinyi|cpuser_dbuser|password
# DATABASE_URL=

# ---- Email (SMTP) ---------------------------------------------
# Any SMTP server works (Gmail App Password, cPanel mail, Resend).
# Without SMTP_HOST the site still works — emails are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=Mbilinyi Tech Solutions

# ---- AI assistant (optional) ----------------------------------
OLLAMA_CLOUD_API_KEY=
OLLAMA_MODEL=

# ---- Site -----------------------------------------------------
APP_TIMEZONE=Africa/Dar_es_Salaam
