# PHP sessions contain sensitive runtime data (CSRF tokens, session IDs)
storage/sessions/
# SQLite database created automatically by the zero-config fallback.
# Contains real user/request data — never publish it.
storage/*.sqlite
storage/*.sqlite-wal
storage/*.sqlite-shm
# Environment secrets
.env
.env.local
.env.*.local
# Local scratch
tmp/
scripts/__pycache__/
# Diagnostic probes that hold a live credential (Supabase PAT / SMTP password).
# They are one-off troubleshooting tools — never publish them.
scripts/.smtp-backup.json
scripts/supabase-*.php
scripts/api-check2.php
scripts/ollama-probe.php
# OS junk
.DS_Store
Thumbs.db
# Editor
.vscode/
.idea/

# Rust build output: ~1.3 GB of objects, and reproducible with `cargo build`.
rust/mts-core/target/
# The runtime database the Rust core creates (same rule as storage/*.sqlite).
storage/mts.sqlite
storage/mts.sqlite-wal
storage/mts.sqlite-shm
